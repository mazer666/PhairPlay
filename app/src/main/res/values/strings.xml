    <!-- ── Diagnostics screen (M14) ────────────────────────────────────── -->
    <string name="diagnostics_title">PhairPlay diagnostics</string>
    <string name="diagnostics_device">Device</string>
    <string name="diagnostics_address">Local address</string>
    <string name="diagnostics_version">Version</string>
    <string name="diagnostics_platform">Platform</string>
    <string name="diagnostics_service">Service</string>
    <string name="diagnostics_section_protocols">Protocols</string>
    <string name="diagnostics_section_ports">Ports</string>
    <string name="diagnostics_section_self_test">Self-test</string>
