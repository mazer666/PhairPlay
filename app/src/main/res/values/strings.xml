<?xml version="1.0" encoding="utf-8"?>
<!--
    strings.xml — English (base locale)

    ALL user-visible strings MUST be defined here (i18n RULE: never hardcode strings in Kotlin/XML).
    Every locale file res/values-<locale>/strings.xml must contain every key of this file.
    scripts/check-i18n-completeness.sh enforces that in CI — a missing key would
    otherwise fall back to English on the TV screen without any build error.
    The format placeholders (%1$s) must match the translation exactly.
-->
