    <string name="diagnostics_selftest_button">Run self-test</string>
    <string name="diagnostics_running">Running the self-test…</string>
    <!-- %1$d = the number of failed checks, %2$d = the number of checks -->
    <!-- %1$d = the number of failed checks, %2$d = the number of checks -->
    <plurals name="diagnostics_finished">
        <item quantity="one">Self-test finished: %1$d of %2$d check failed</item>
        <item quantity="other">Self-test finished: %1$d of %2$d checks failed</item>
    </plurals>
