    <string name="diagnostics_port_dlna_description">DLNA description</string>
    <string name="diagnostics_port_ssdp">SSDP</string>
    <string name="diagnostics_selftest_description">Description server</string>
    <string name="diagnostics_selftest_ssdp">SSDP multicast</string>
    <string name="diagnostics_selftest_airplay_port">AirPlay port</string>
    <string name="diagnostics_selftest_process">App process</string>
    <string name="diagnostics_status_ok">OK</string>
    <string name="diagnostics_status_failed">failed</string>
    <string name="diagnostics_not_run_yet">not run yet</string>
    <!-- %1$s = the address that was found -->
    <string name="diagnostics_reason_no_address">no usable IPv4 address (%1$s)</string>
    <!-- %1$s = the endpoint, e.g. 127.0.0.1:7000 -->
    <string name="diagnostics_reason_no_listener">no listener on %1$s</string>
    <string name="diagnostics_reason_port_unknown">port unknown — no SSDP answer</string>
    <!-- %1$s = the multicast group, %2$d = the timeout in milliseconds -->
    <string name="diagnostics_reason_no_ssdp_answer">no answer from %1$s within %2$d ms</string>
    <!-- %1$s = the reason the socket could not be opened -->
    <string name="diagnostics_reason_socket_failed">multicast socket failed: %1$s</string>
    <string name="diagnostics_reason_not_measured">not measured</string>
    <!-- %1$d = the HTTP status, %2$d = the number of bytes of the answer -->
    <!-- %1$d = the HTTP status, %2$d = the length of the answer in bytes -->
    <plurals name="diagnostics_detail_http_ok">
        <item quantity="one">HTTP %1$d, %2$d byte</item>
        <item quantity="other">HTTP %1$d, %2$d bytes</item>
    </plurals>
    <!-- %1$d = the HTTP status -->
    <string name="diagnostics_detail_http_failed">HTTP %1$d</string>
    <!-- %1$d = the resident memory of the app process in kilobytes -->
    <string name="diagnostics_detail_resident_memory">resident memory %1$d kB</string>
